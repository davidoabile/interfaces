function personalBottom(w,h,p,t){const y=h-86,items=[['chat','Chat'],['user','Personas'],['layers','Knowledge'],['tasks','Tasks']];let s=`<rect y="${y}" width="${w}" height="86" fill="${t.panel}"/><path d="M0 ${y}H${w}" stroke="${t.border}"/>`;items.forEach(([ic,label],i)=>{const cx=w*(i+.5)/4;if(!i&&p==='android')s+=`<rect x="${cx-29}" y="${y+8}" width="58" height="30" rx="15" fill="${t.selected}"/>`;s+=uiIcon(ic,cx-11,y+12,22,i?t.secondary:t.indicator)+center(cx,y+58,label,11,i?400:500,i?t.secondary:t.link);});return s+`<rect x="${w/2-60}" y="${h-11}" width="120" height="4" rx="2" fill="${t.heading}"/>`;}
function personalRail(h,t){const items=[['chat','Chat'],['user','Personas'],['layers','Knowledge'],['tasks','Tasks']];let s=`<rect width="80" height="${h}" fill="${t.panel}"/><path d="M80 36V${h}" stroke="${t.border}"/>`;s+=uiIcon('menu',28,69,24,t.body);items.forEach(([ic,label],i)=>{const yy=177+i*90;if(!i)s+=`<rect x="12" y="${yy-9}" width="56" height="40" rx="20" fill="${t.selected}"/>`;s+=uiIcon(ic,28,yy,24,i?t.secondary:t.indicator)+center(40,yy+54,label,10,i?400:500,i?t.secondary:t.link);});s+=`<circle cx="40" cy="${h-62}" r="18" fill="${t.selected}"/>`+center(40,h-57,'DW',11,500,t.heading);return s;}
function personalSidebar(h,p,t,theme){let s=`<rect width="224" height="${h}" fill="${t.panel}"/><path d="M224 36V${h}" stroke="${t.border}"/>`;s+=vector(theme==='dark'?'logos/Black BG Main Logo.svg':'logos/Main Logo.svg',24,62,142,32,theme==='dark');s+=primary(16,126,192,'New conversation',p,t);const items=[['chat','Chat'],['user','My Personas'],['briefcase','My.Career'],['layers','Knowledge'],['tasks','My tasks']];items.forEach(([ic,label],i)=>{const yy=194+i*46;if(!i)s+=`<rect x="12" y="${yy-7}" width="200" height="40" rx="8" fill="${t.selected}"/>`;s+=uiIcon(ic,24,yy+2,20,i?t.secondary:t.indicator)+text(58,yy+18,label,14,i?400:500,i?t.body:t.heading);});s+=`<path d="M24 439h176" stroke="${t.border}"/>`+text(24,471,'Recent conversations',12,500,t.secondary);[['Career transition options','Yesterday, 4:18 pm'],['Skill development plan','14 Jan, 9:02 am']].forEach(([label,time],i)=>{const yy=506+i*66;s+=uiIcon('chat',24,yy,17,t.secondary)+text(51,yy+10,label,12,500,t.body)+text(51,yy+31,time,11,400,t.secondary);});s+=uiIcon('business',24,h-117,20,t.secondary)+text(54,h-102,'Add business account',13,400,t.body)+`<circle cx="40" cy="${h-54}" r="18" fill="${t.selected}"/>`+text(70,h-49,'David W.',14,500,t.heading)+center(40,h-49,'DW',11,500,t.heading)+uiIcon('down',187,h-64,18,t.secondary);return s;}
function suggestion(x,y,w,h,label,ic,p,t){let s=box(x,y,w,h,t,false,p==='android'?16:12);s+=uiIcon(ic,x+16,y+16,22,t.indicator);if(h>70){wrap(label,w-32,14).forEach((line,i)=>s+=text(x+16,y+66+i*20,line,14,500,t.heading));}else{s+=text(x+53,y+32,label,14,500,t.heading)+uiIcon('chevron',x+w-28,y+20,16,t.secondary);}return s;}
function recent(x,y,w,title,time,t){return box(x,y,w,66,t)+uiIcon('chat',x+16,y+20,20,t.secondary)+text(x+49,y+28,title,14,500,t.heading)+text(x+49,y+49,time,12,400,t.secondary)+uiIcon('chevron',x+w-27,y+23,16,t.secondary);}
function composer(x,y,w,p,t){let s=box(x,y,w,108,t,false,p==='android'?24:18);s+=`<rect x="${x+14}" y="${y+12}" width="126" height="30" rx="${p==='android'?15:8}" fill="${t.raised}" stroke="${t.control}"/>`+uiIcon('user',x+23,y+19,16,t.body)+text(x+47,y+32,'My Persona',13,500,t.heading)+uiIcon('down',x+116,y+20,14,t.secondary);s+=text(x+18,y+77,'Ask Sigmar anything',16,400,t.secondary)+uiIcon('attach',x+w-102,y+56,22,t.body)+`<rect x="${x+w-58}" y="${y+48}" width="44" height="44" rx="${p==='android'?22:12}" fill="${t.accent}"/>`+uiIcon('send',x+w-47,y+59,22,t.onAccent);return s;}
function renderPersonal(p,theme,l){const t=tokens[theme],phone=l.w<600,wide=l.w>=1100,rail=!phone&&!wide&&p==='android',navW=wide?224:rail?80:0,bottom=phone||p==='ios'&&!wide,margin=phone?24:32,available=l.w-navW-2*margin,cw=Math.min(760,available),x=navW+(l.w-navW-cw)/2,mid=x+cw/2,id=`personal-${p}-${theme}-${l.id}`;const composerY=l.h-(bottom?206:160);let s=`<svg xmlns="http://www.w3.org/2000/svg" width="${l.w}" height="${l.h}" viewBox="0 0 ${l.w} ${l.h}" font-family="Satoshi, sans-serif"><title>Personal Sigmar AOS assistant · ${p==='ios'?'iOS / iPadOS':'Android'} · ${theme}</title><desc>Initial assistant view using source mockup example conversations. No live account data.</desc><defs><clipPath id="frame-${id}"><rect width="${l.w}" height="${l.h}" rx="24"/></clipPath><filter id="blur-${id}" x="-15%" y="-10%" width="130%" height="120%"><feGaussianBlur stdDeviation="10"/></filter></defs><g clip-path="url(#frame-${id})"><rect width="${l.w}" height="${l.h}" fill="${t.canvas}"/><image data-dna="true" href="../login-register/samples/sigmar-dna-${theme}-background.png" x="${navW}" width="${l.w-navW}" height="${l.h}" preserveAspectRatio="xMidYMid slice" opacity="0.08" filter="url(#blur-${id})"/>`;
 if(wide)s+=personalSidebar(l.h,p,t,theme);else if(rail)s+=personalRail(l.h,t);
 s+=text(28,26,'9:41',12,500,t.heading)+text(l.w-28,26,'Wi-Fi  100%',11,400,t.secondary,'end');
 if(!wide){if(!rail)s+=uiIcon('menu',20,59,24,t.body);const lx=rail?navW+24:64;s+=vector(theme==='dark'?'logos/Black BG Main Logo.svg':'logos/Main Logo.svg',lx,56,124,28,theme==='dark')+text(lx+140,78,'AOS',13,500,t.secondary)+uiIcon('plus',l.w-49,59,24,t.body);}
 else{s+=text(navW+32,83,'Personal workspace',14,500,t.body)+uiIcon('down',navW+178,69,16,t.secondary)+uiIcon('bell',l.w-96,65,22,t.secondary)+`<circle cx="${l.w-44}" cy="77" r="17" fill="${t.selected}"/>`+center(l.w-44,82,'DW',11,500,t.heading);}
 if(!wide)s+=text(x,126,'Personal workspace',13,500,t.secondary)+`<circle cx="${l.w-41}" cy="120" r="16" fill="${t.selected}"/>`+center(l.w-41,125,'DW',10,500,t.heading);
 const heroY=phone?165:l.id==='tablet-compact'?190:wide?218:243,coin=phone?46:56;
 s+=vector('sigmar-ia-icons/idle.svg',mid-coin/2,heroY,coin,coin)+center(mid,heroY+coin+38,'How can I help you today?',22,500,t.heading)+center(mid,heroY+coin+66,'Your AI works within your authorised Persona.',phone?13:14,400,t.secondary);
 const suggestions=[['Explore career options','briefcase'],['Review my priorities','tasks'],['Develop a new skill','book']],sy=heroY+coin+98,three=cw>=620;
 if(three){const sw=(cw-24)/3;suggestions.forEach(([label,ic],i)=>s+=suggestion(x+i*(sw+12),sy,sw,104,label,ic,p,t));}
 else suggestions.forEach(([label,ic],i)=>s+=suggestion(x,sy+i*64,cw,52,label,ic,p,t));
 if(!wide){const ry=three?sy+152:sy+3*64+22;s+=text(x,ry,'Recent conversations',13,500,t.secondary)+text(x+cw,ry,'View all',12,500,t.link,'end');if(three){const rw=(cw-12)/2;s+=recent(x,ry+18,rw,'Career transition options','Yesterday, 4:18 pm',t)+recent(x+rw+12,ry+18,rw,'Skill development plan','14 Jan, 9:02 am',t);}else{const rowH=phone?44:66;s+=uiIcon('chat',x+3,ry+20,18,t.secondary)+text(x+32,ry+33,'Career transition options',14,400,t.body)+uiIcon('chevron',x+cw-18,ry+22,14,t.secondary);s+=uiIcon('chat',x+3,ry+rowH+20,18,t.secondary)+text(x+32,ry+rowH+33,'Skill development plan',14,400,t.body)+uiIcon('chevron',x+cw-18,ry+rowH+22,14,t.secondary);}}
 s+=composer(x,composerY,cw,p,t);
 if(!phone)s+=center(mid,composerY+133,'You can manage your Personas and conversations.',12,400,t.secondary);
 if(bottom)s+=personalBottom(l.w,l.h,p,t);else s+=`<rect x="${l.w/2-60}" y="${l.h-14}" width="120" height="4" rx="2" fill="${t.heading}"/>`;
 s+=`<rect x=".5" y=".5" width="${l.w-1}" height="${l.h-1}" rx="24" fill="none" stroke="${t.border}"/></g></svg>`;return s;}
